{
  "manifest_version": 3,
  "name": "Media Ops Public Metrics Collector",
  "version": "0.5.3",
  "description": "Reads public account and content metrics for Media Ops; server-side monitoring decides what is new.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://fb.watch/*",
    "https://*.pinterest.com/*",
    "https://pin.it/*",
    "https://*.app.github.dev/*",
    "http://localhost:3100/*"
  ],
  "background": {
    "service_worker": "service-worker-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["youtube-main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": ["youtube-account-metrics.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://fb.watch/*",
        "https://*.pinterest.com/*",
        "https://pin.it/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Media Ops Public Metrics Collector"
  }
}
