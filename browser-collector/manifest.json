{
  "manifest_version": 3,
  "name": "Media Ops Public Metrics Collector",
  "version": "0.4.0",
  "description": "Monitors public account totals and collects only content first seen after monitoring begins.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://fb.watch/*",
    "https://*.pinterest.com/*",
    "https://pin.it/*",
    "https://*.app.github.dev/*",
    "http://localhost:3100/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.pinterest.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Media Ops Public Metrics Collector"
  }
}
